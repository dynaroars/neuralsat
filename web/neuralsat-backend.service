[Unit]
Description=NeuralSAT Web Backend Service
After=network.target

[Service]
User=webapp
WorkingDirectory=/home/webapp/neuralsat/web
ExecStart=/home/webapp/neuralsat/web/run_server.sh 5050
Restart=always
RestartSec=5
Environment=PATH=/home/webapp/neuralsat/web/venv/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
