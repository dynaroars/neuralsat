[Unit]
Description=Ngrok Tunnel Service for NeuralSAT
After=network.target neuralsat-backend.service

[Service]
Type=simple
User=webapp
ExecStart=/usr/local/bin/ngrok http 5050 --domain=shingle-unhinge-concert.ngrok-free.dev --config=/home/webapp/ngrok-neuralsat.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
